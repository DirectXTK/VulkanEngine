CONFIG=${1:-"debug"}
./premake5 gmake
CORECOUNT=$(getconf _NPROCESSORS_ONLN)
STARTTIME=$(date +%s)
make -j$CORECOUNT config=$CONFIG
status=$?
ENDTIME=$(date +%s)
echo "Compilation took : $((ENDTIME-STARTTIME))ms"
exePath=$(cat ExeLocation)
echo "Executable directory:" $exePath
if [ $status = 0 ]; then
 ./bin/$exePath/Sandbox
fi
