#version 460
#extension GL_EXT_nonuniform_qualifier : enable
precision highp float;

layout(location =0) in vec4 InColor;
layout(location =1) in vec2 TexCoords;
layout(location =2) flat in uint TexID;
layout(location =3) flat in uvec2 InID;

layout(location =0) out vec4 OutInColor;
layout(location =1) out uvec2 OutInColor2;

layout(set =1 ,binding =0) uniform sampler2D TextureSampler[1000];



void main(){

   OutInColor = InColor*texture(TextureSampler[nonuniformEXT(TexID)],TexCoords);
   OutInColor2 = InID;
}
   